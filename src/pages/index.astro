---
import BaseLayout from '../layouts/BaseLayout.astro';
import SectionHeading from '../components/SectionHeading.astro';
import MemberCard from '../components/MemberCard.astro';
import ActivityRow from '../components/ActivityRow.astro';
import { activities, members, siteConfig } from '../data/site';
---
<BaseLayout>
  <section class="hero container">
    <div class="hero-copy" data-reveal><p class="eyebrow">{siteConfig.name} / {siteConfig.displayName}</p><h1>讓想法 <span>開始運作。</span></h1><p class="hero-lede">機研不只是把零件接起來，也是在一群人之間，把好奇心、問題和下一次嘗試接起來。</p><div class="hero-actions"><a class="button button--primary" href="/about/">認識社團 <span aria-hidden="true">→</span></a><a class="button button--quiet" href={siteConfig.recruitmentUrl} target="_blank" rel="noreferrer">前往招生系統 <span aria-hidden="true">↗</span></a></div></div>
    <div class="hero-system" data-reveal><div class="system-line system-line--top"><span>STATUS</span><strong>CURIOUS / BUILDING</strong></div><div class="system-core"><span class="system-orbit system-orbit--one"></span><span class="system-orbit system-orbit--two"></span><span class="system-dot"></span><span class="system-core-label">PJMI</span></div><div class="system-line system-line--bottom"><span>LOCAL NODE</span><strong>ZHEN-GAO HIGH</strong></div></div>
  </section>

  <section class="section section--paper container">
    <SectionHeading eyebrow="我們在做的事" title="不只學工具，還要學會一起完成。" description="從一個問題開始，拆解、試做、失敗，再把能運作的部分留下來。這裡是社團內容的入口，也是新生第一次認識 PJMI 的地方。" />
    <div class="principles-grid"><article class="principle-card principle-card--dark" data-reveal><span class="principle-symbol">01</span><div><h3>拆開問題</h3><p>把看起來很大的題目，變成今天可以試一次的小步驟。</p></div></article><article class="principle-card principle-card--lime" data-reveal><span class="principle-symbol">02</span><div><h3>動手實驗</h3><p>程式、電路、結構與資料都可以是我們用來思考的材料。</p></div></article><article class="principle-card principle-card--coral" data-reveal><span class="principle-symbol">03</span><div><h3>留下紀錄</h3><p>把過程整理下來，讓下一個人可以從我們走過的地方繼續。</p></div></article></div>
  </section>

  <section class="section section--dark"><div class="container"><SectionHeading eyebrow="社員索引" title="每個人都帶著一個正在成形的方向。" description="這裡會放上社員的名字、年級、角色和正在研究的東西。先看看我們怎麼組成，再想像你可以放進哪一塊。" /><div class="member-preview-grid">{members.slice(0, 3).map((member) => <MemberCard member={member} />)}</div><a class="button button--light" href="/members/">查看全部社員 <span aria-hidden="true">→</span></a></div></section>

  <section class="section section--tinted"><div class="container activity-split"><SectionHeading eyebrow="參與過的活動" title="一起做過的事，會變成下一次的起點。" description="競賽、展覽與科學活動會把我們帶到不同的問題裡。這裡記錄那些讓 PJMI 繼續往前的節點。" /><div class="activity-list">{activities.slice(0, 2).map((activity) => <ActivityRow activity={activity} />)}<a class="text-link" href="/activities/">看完整活動紀錄 <span aria-hidden="true">→</span></a></div></div></section>

  <section class="join-banner container" data-reveal><div><p class="eyebrow">準備好一起做了嗎？</p><h2>把下一個問題帶進來。</h2></div><a class="button button--dark" href={siteConfig.recruitmentUrl} target="_blank" rel="noreferrer">前往招生系統 <span aria-hidden="true">↗</span></a></section>
</BaseLayout>
