---
import BaseLayout from '../../layouts/BaseLayout.astro';
import MemberCard from '../../components/MemberCard.astro';
import { members } from '../../data/site';
---
<BaseLayout title="社員／PJMI 鎮高機研">
  <section class="page-hero page-hero--single page-hero--catalogue container"><div data-reveal><p class="eyebrow">MEMBERS / INDEX</p><h1>正在一起做事的人。</h1></div></section>
  <section class="section container"><div class="catalogue-meta"><span>{members.length} entries / content pending</span><span>鎮高機研社員索引</span></div><div class="member-catalogue-grid">{members.map((member) => <MemberCard member={member} />)}</div></section>
</BaseLayout>
