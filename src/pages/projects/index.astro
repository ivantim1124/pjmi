---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ProjectCard from '../../components/ProjectCard.astro';
import SectionHeading from '../../components/SectionHeading.astro';
import { projects } from '../../data/site';
---
<BaseLayout title="作品／PJMI 鎮高機研">
  <section class="page-hero page-hero--single container"><div data-reveal><p class="eyebrow">PROJECTS / WORKBENCH</p><h1>讓想法留下 <span>可以被看見的形狀。</span></h1></div></section>
  <section class="section container"><SectionHeading eyebrow="PROJECT INDEX" title="每個作品都從一個問題開始。" /><div class="project-grid project-grid--large">{projects.map((project) => <ProjectCard project={project} />)}</div></section>
</BaseLayout>
