---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ActivityRow from '../../components/ActivityRow.astro';
import SectionHeading from '../../components/SectionHeading.astro';
import { activities } from '../../data/site';
---
<BaseLayout title="活動／pjmi 鎮高機研">
  <section class="page-hero container"><div data-reveal><p class="eyebrow">ACTIVITIES / LOG</p><h1>一起做過的事，<br /><span>會變成下一次的起點。</span></h1></div><p class="page-hero-note" data-reveal>社課、工作坊、競賽與分享，這裡會留下社團如何移動、如何學會新東西的紀錄。</p></section>
  <section class="section container"><SectionHeading eyebrow="ACTIVITY LOG" title="把過程也算進成果裡。" description="補上真實活動資料後，這裡可以成為招生時最直接的社團日常入口。" /><div class="activity-log">{activities.map((activity) => <ActivityRow activity={activity} />)}</div></section>
</BaseLayout>
