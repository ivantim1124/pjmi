---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ActivityRow from '../../components/ActivityRow.astro';
import SectionHeading from '../../components/SectionHeading.astro';
import { activities } from '../../data/site';
---
<BaseLayout title="活動／PJMI 鎮高機研">
  <section class="page-hero container"><div data-reveal><p class="eyebrow">ACTIVITIES / LOG</p><h1>參與過的活動 <span>會變成下一次的起點。</span></h1></div><p class="page-hero-note" data-reveal>競賽、展覽與科學活動，這裡會留下 PJMI 如何移動、如何學會新東西的紀錄。</p></section>
  <section class="section container"><SectionHeading eyebrow="參與過的活動" title="把過程也算進成果裡。" description="以下整理 PJMI 參與過的競賽、展覽與科學活動。" /><div class="activity-log">{activities.map((activity) => <ActivityRow activity={activity} />)}</div></section>
</BaseLayout>
