---
import { siteConfig } from '../data/site';

const links = [
  { href: siteConfig.competitionBoardUrl, label: '比賽專區' },
  { href: siteConfig.vocabularyPracticeUrl, label: '單字練習' },
];
---
<header class="site-header">
  <div class="header-shell">
    <a class="brand-lockup" href="/" aria-label={`${siteConfig.name} 首頁`}>
      <span class="brand-mark">{siteConfig.name}</span>
      <span class="brand-name">{siteConfig.displayName}</span>
    </a>
    <nav class="desktop-nav" aria-label="主要導覽">
      {links.map((link) => <a class="nav-link" href={link.href}>{link.label} <span aria-hidden="true">↗</span></a>)}
    </nav>
    <details class="mobile-nav">
      <summary aria-label="開啟導覽選單"><span></span><span></span></summary>
      <div class="mobile-nav-panel">
        {links.map((link) => <a class="mobile-nav-link" href={link.href}>{link.label} <span aria-hidden="true">↗</span></a>)}
      </div>
    </details>
  </div>
</header>
