---
import type { Member } from '../data/site';
interface Props { member: Member; }
const { member } = Astro.props;
---
<article class:list={["member-card", `member-card--${member.accent}`]} data-reveal>
  <div class="card-index" aria-hidden="true">{member.slug.replace('member-', '#')}</div>
  <div class="member-avatar" aria-hidden="true"><span>{member.name.slice(0, 1)}</span></div>
  <div class="member-main">
    <p class="member-grade">{member.grade}</p>
    <h3>{member.name}</h3>
    <p class="member-role">{member.role}</p>
    <div class="tag-row">{member.tags.map((tag) => <span class="tag">{tag}</span>)}</div>
  </div>
</article>
