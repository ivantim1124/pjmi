---
import EnglishWordLayout from '../layouts/EnglishWordLayout.astro';
---
<EnglishWordLayout title="找不到頁面／englishword">
  <section class="login-shell" aria-labelledby="not-found-title">
    <div class="panel panel--raised">
      <div class="panel__body">
        <p class="eyebrow">404 / NOT FOUND</p>
        <h1 id="not-found-title">這個頁面還沒有接上。</h1>
        <p class="page-intro__note">回到練習頁，選一個範圍開始。</p>
        <div class="result-actions"><a class="button button--primary" href="/">回到練習 <span aria-hidden="true">→</span></a></div>
      </div>
    </div>
  </section>
</EnglishWordLayout>
